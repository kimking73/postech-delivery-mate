# 복사해서 .env.local로 쓴다(.env*.local은 커밋되지 않음). 공개되어도 되는 값만 넣는다(아키텍처 §11).
# 비밀키(service_role, SMTP 비밀번호 등)는 절대 여기에 넣지 않는다.

# local: `supabase start` 출력의 API URL·anon key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 1이면 목 데이터 사용(CL2). URL/KEY가 비어 있어도 목 모드
EXPO_PUBLIC_USE_MOCK=1

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_LINK_DOMAIN=example.kr

# 무료 Apple 계정으로 아이폰 로컬 빌드할 때만: 본인 영문 이니셜 (예: jy → kr.postech.deliverymate.dev.jy)
DEV_BUNDLE_SUFFIX=
